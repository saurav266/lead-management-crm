# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API with credentials
# (only needed if you run the client on a different origin than the server,
# e.g. Vite dev server on 5173 while the API runs on 5000)
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Seed admin account created automatically on first boot if no admin exists yet
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# ---- Database ----
# PostgreSQL connection string, e.g. postgres://user:password@host:5432/dbname
# For local dev, the quickest option is a throwaway Docker container:
#   docker run --name crm-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=

# ---- Google Sheets ----
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Path to the service-account JSON key file (recommended), OR set
# GOOGLE_SERVICE_ACCOUNT_JSON below with the raw JSON contents instead.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Minutes between automatic sheet imports. Set to 0 to disable the scheduler
# (the "Sync now" button still works).
SHEET_SYNC_INTERVAL_MINUTES=2
